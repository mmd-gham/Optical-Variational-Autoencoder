import torch
import torch.nn as nn
import torch.nn.functional as F
import pytorch_lightning as pl

from models.optical_layers import OpticalLayer

class OpticalVAE(pl.LightningModule):
    def __init__(self, latent_dim=16, lambda_phase=1e-3):
        super().__init__()
        self.latent_dim = latent_dim
        self.lambda_phase = lambda_phase

        # Encoder
        self.enc1 = OpticalLayer((28,28), channels=4)
        self.pool1 = nn.AvgPool2d(2)  # 28->14
        self.enc2 = OpticalLayer((14,14), channels=8)
        self.pool2 = nn.AvgPool2d(2)  # 14->7

        self.flatten = nn.Flatten()
        self.fc_mu = nn.Linear(8 * 7 * 7, latent_dim)
        self.fc_logvar = nn.Linear(8 * 7 * 7, latent_dim)

        # Decoder
        self.fc_dec = nn.Linear(latent_dim, 8 * 7 * 7)
        self.deopt1 = OpticalLayer((7,7), channels=4)
        self.upsample1 = nn.Upsample(scale_factor=2)
        self.deopt2 = OpticalLayer((14,14), channels=1)
        self.upsample2 = nn.Upsample(scale_factor=2)

    def encode(self, x):
        x = self.pool1(self.enc1(x))
        x = self.pool2(self.enc2(x))
        x = self.flatten(x)
        return self.fc_mu(x), self.fc_logvar(x)

    def reparameterize(self, mu, logvar):
        std = torch.exp(0.5 * logvar)
        eps = torch.randn_like(std)
        return mu + eps * std

    def decode(self, z):
        x = self.fc_dec(z).view(-1, 8, 7, 7)
        x = self.upsample1(self.deopt1(x))
        x = self.upsample2(self.deopt2(x))
        return torch.sigmoid(x)

    def forward(self, x):
        mu, logvar = self.encode(x)
        z = self.reparameterize(mu, logvar)
        return self.decode(z), mu, logvar

    def training_step(self, batch, batch_idx):
        x,_ = batch
        recon, mu, logvar = self(x)

        recon_loss = F.mse_loss(recon, x)
        kld = -0.5 * torch.mean(1 + logvar - mu**2 - logvar.exp())
        smooth = self.enc1.phase_smoothness() + self.enc2.phase_smoothness()

        loss = recon_loss + kld + self.lambda_phase * smooth
        self.log("train_loss", loss)
        return loss

    def validation_step(self, batch, batch_idx):
        x,_ = batch
        recon, mu, logvar = self(x)
        recon_loss = F.mse_loss(recon, x)
        kld = -0.5 * torch.mean(1 + logvar - mu**2 - logvar.exp())
        self.log("val_loss", recon_loss + kld)

    def configure_optimizers(self):
        return torch.optim.Adam(self.parameters(), lr=1e-3)
