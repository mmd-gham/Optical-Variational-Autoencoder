import pytorch_lightning as pl
from data.datamodule import MNISTDataModule
from models.optical_vae import OpticalVAE

dm = MNISTDataModule(batch_size=128)
dm.setup()

model = OpticalVAE(latent_dim=16, lambda_phase=1e-3)

trainer = pl.Trainer(
    max_epochs=10,
    accelerator="gpu" if torch.cuda.is_available() else "cpu",
    devices=1
)
trainer.fit(model, dm)
